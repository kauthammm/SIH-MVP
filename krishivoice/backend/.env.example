# Local demo — CSV files, no PostgreSQL needed (default)
# USE_POSTGRES=false

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# OpenRouter — VL soil OCR + Tamil advisory polish
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_ENABLED=true
OPENROUTER_VL_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# Tavily — web search when farmer clicks globe icon
TAVILY_API_KEY=tvly-your-key-here
TAVILY_ENABLED=true
TAVILY_TRUSTED_ONLY=true

# data.gov.in — AGMARKNET live mandi prices (free at https://data.gov.in)
DATA_GOV_IN_API_KEY=your-data-gov-in-api-key
MANDI_DEFAULT_STATE=Tamil Nadu
